-// a separator is a gap between button groups, not a line
+// a vertical line, a bit taller than the icons, centered in the gap between
+// button groups (matches the old Win32 toolbar separator)
+static void PaintToolbarSeparator(VirtCustom*, VirtPaintCtx* ctx) {
+    Rect r = ctx->bounds;
+    int inset = ToolbarCyPad() - DpiScale(1);
+    int lineDx = DpiScale(1);
+    Rect line{r.x + (r.dx - lineDx) / 2, r.y + inset, lineDx, r.dy - (2 * inset)};
+    ctx->gfx->FillRect(line, TbEdgeColor());
+}
+
+// a separator is a gap between button groups with a line in the middle
 static VirtCtrl* MakeToolbarSeparator(int rowDy) {
     auto* sep = new VirtCustom();
-    sep->idealSize = {DpiScale(12), rowDy};
+    sep->idealSize = {DpiScale(8), rowDy};
+    sep->onPaint = MkFunc1(PaintToolbarSeparator, sep);
     sep->SetFlag(vwfNoHitTest, true);
     return sep;
 }
