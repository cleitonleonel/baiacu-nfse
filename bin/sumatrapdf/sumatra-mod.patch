+// clang-format on
+
+// ids outside the command range (controls, find bar buttons) aren't commands
+static bool IsCmdAllowedByMod(int cmdId) {
+    if (cmdId < CmdFirst || cmdId >= CmdLast) {
+        return true;
+    }
+    if (cmdId >= CmdZoomFirst && cmdId <= CmdZoomLast) {
+        return true;
+    }
+    for (int i = 0; gModAllowedCmds[i]; i++) {
+        if (gModAllowedCmds[i] == cmdId) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Ctrl+V / Ctrl+X / Ctrl+Z are bound to blocked commands but must keep
+// working in the find box
+static void ModForwardBlockedEditCmd(int cmdId) {
+    switch (cmdId) {
+        case CmdPasteClipboardImage:
+            ForwardEditMsgToFocusedEditControl(WM_PASTE);
+            break;
+        case CmdCutAnnotation:
+            ForwardEditMsgToFocusedEditControl(WM_CUT);
+            break;
+        case CmdUndo:
+            ForwardEditMsgToFocusedEditControl(WM_UNDO);
+            break;
+    }
+}
